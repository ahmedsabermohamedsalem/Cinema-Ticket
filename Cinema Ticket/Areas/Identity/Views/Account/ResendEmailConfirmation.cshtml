@model Cinema_Ticket.Viewmodel.ResendEmailConfirmationVm

@{
    ViewData["Title"] = "ResendEmailConfirmation";
      Layout = "_Layout";

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
}

<h1>ResendEmailConfirmation</h1>

<h4>ResendEmailConfirmationVM</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ResendEmailConfirmation">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserNameOrEmail" class="control-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ResendEmailConfirmation" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Login">Login</a>
</div>