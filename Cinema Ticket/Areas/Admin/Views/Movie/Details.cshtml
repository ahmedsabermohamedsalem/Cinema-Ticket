@model Cinema_Ticket.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Movie Details
        </h2>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>


    <!-- ================= Movie Information ================= -->

    <div class="card shadow mb-4">

        <div class="row g-0">

            <!-- Main Movie Image -->
            <div class="col-md-4">

                @if (!string.IsNullOrEmpty(Model.MainImg))
                {
                    <img src="~/uploadsFile/@Model.MainImg"
                         class="img-fluid rounded-start"
                         alt="@Model.Name"
                         style="width:100%; height:400px; object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center bg-light"
                         style="height:400px;">

                        <span class="text-muted">
                            No Movie Image
                        </span>

                    </div>
                }

            </div>


            <!-- Movie Data -->
            <div class="col-md-8">

                <div class="card-body">

                    <h2 class="card-title mb-3">
                        @Model.Name
                    </h2>


                    <!-- Description -->

                    <p class="card-text">
                        @Model.Description
                    </p>

                    <hr />


                    <div class="row">

                        <!-- Price -->

                        <div class="col-md-6 mb-3">

                            <strong>
                                Price:
                            </strong>

                            <span>
                                @Model.Price
                            </span>

                        </div>


                        <!-- Duration -->

                        <div class="col-md-6 mb-3">

                            <strong>
                                Duration:
                            </strong>

                            <span>
                                @Model.Duration minutes
                            </span>

                        </div>


                        <!-- Release Date -->

                        <div class="col-md-6 mb-3">

                            <strong>
                                Release Date:
                            </strong>

                            <span>
                                @Model.ReleaseDate.ToString("yyyy-MM-dd")
                            </span>

                        </div>


                        <!-- Category -->

                        <div class="col-md-6 mb-3">

                            <strong>
                                Category:
                            </strong>

                            @if (Model.Category != null)
                            {
                                <span>
                                    @Model.Category.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Category
                                </span>
                            }

                        </div>


                        <!-- Cinema -->

                        <div class="col-md-6 mb-3">

                            <strong>
                                Cinema:
                            </strong>

                            @if (Model.Cinema != null)
                            {
                                <span>
                                    @Model.Cinema.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Cinema
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ================= Actors ================= -->

    <div class="card shadow mb-4">

        <div class="card-header">

            <h4 class="mb-0">
                Actors
            </h4>

        </div>


        <div class="card-body">

            @if (Model.MovieActors != null &&
                 Model.MovieActors.Any())
            {
                <div class="row">

                    @foreach (var movieActor in Model.MovieActors)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                            <div class="card h-100 shadow-sm">


                                <!-- Actor Image -->

                                @if (!string.IsNullOrEmpty(movieActor.Actor?.Img))
                                {
                                    <img src="~/uploadsFile/@movieActor.Actor.Img"
                                         class="card-img-top"
                                         alt="@movieActor.Actor.Name"
                                         style="height:250px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-light"
                                         style="height:250px;">

                                        <span class="text-muted">
                                            No Actor Image
                                        </span>

                                    </div>
                                }


                                <!-- Actor Name -->

                                <div class="card-body text-center">

                                    <h5 class="card-title mb-0">

                                        @movieActor.Actor?.Name

                                    </h5>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    No actors found for this movie.
                </div>
            }

        </div>

    </div>



    <!-- ================= Movie Images ================= -->

    <div class="card shadow mb-4">

        <div class="card-header">

            <h4 class="mb-0">
                Movie Images
            </h4>

        </div>


        <div class="card-body">

            @if (Model.MovieImages != null &&
                 Model.MovieImages.Any())
            {
                <div class="row">

                    @foreach (var image in Model.MovieImages)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                            <div class="card shadow-sm">

                                @if (!string.IsNullOrEmpty(image.Img))
                                {
                                    <img src="~/uploadsFile/@image.Img"
                                         class="card-img-top"
                                         alt="@Model.Name"
                                         style="height:220px; object-fit:cover;" />
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    No additional images found.
                </div>
            }

        </div>

    </div>



    <!-- ================= Bottom Buttons ================= -->

    <div class="mb-5">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="bi bi-pencil"></i>
            Edit

        </a>


        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">

            <i class="bi bi-trash"></i>
            Delete

        </a>


        <a asp-action="Index"
           class="btn btn-secondary">

            Back to Movies

        </a>

    </div>

</div>