@model Cinema_Ticket.Viewmodel.movieModelVM

@{
    ViewData["Title"] = "Edit Movie";
}

<div class="container mt-4">

    <!-- ========================= -->
    <!-- Header -->
    <!-- ========================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="display-6">
            Edit Movie
        </h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Movies
        </a>

    </div>


    <div class="card shadow">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <!-- Movie Id -->

                <input type="hidden"
                       asp-for="Movie.Id" />


                <!-- Anti Forgery -->

                @Html.AntiForgeryToken()


                <!-- Validation -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ========================= -->
                <!-- Movie Name -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.Name"
                           class="form-label">
                        Movie Name
                    </label>

                    <input asp-for="Movie.Name"
                           class="form-control" />

                    <span asp-validation-for="Movie.Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Description -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Movie.Description"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="Movie.Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Price -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.Price"
                           class="form-label">
                        Price
                    </label>

                    <input asp-for="Movie.Price"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Movie.Price"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Duration -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.Duration"
                           class="form-label">
                        Duration
                    </label>

                    <input asp-for="Movie.Duration"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="Movie.Duration"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Release Date -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.ReleaseDate"
                           class="form-label">
                        Release Date
                    </label>

                    <input asp-for="Movie.ReleaseDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Movie.ReleaseDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Current Main Image -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Current Main Image
                    </label>

                    <div>

                        @if (!string.IsNullOrEmpty(Model.Movie.MainImg))
                        {
                            <img src="~/uploadsFile/@Model.Movie.MainImg"
                                 width="180"
                                 height="180"
                                 class="rounded"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <p class="text-muted">
                                No main image.
                            </p>
                        }

                    </div>

                </div>


                <!-- ========================= -->
                <!-- Change Main Image -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="ImageFile"
                           class="form-label">
                        Change Main Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">
                        Leave empty to keep the current image.
                    </small>

                </div>


                <!-- ========================= -->
                <!-- Category -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.CategoryId"
                           class="form-label">
                        Category
                    </label>

                    <select asp-for="Movie.CategoryId"
                            asp-items="ViewBag.Categories"
                            class="form-select">

                        <option value="">
                            -- Select Category --
                        </option>

                    </select>

                    <span asp-validation-for="Movie.CategoryId"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Cinema -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Movie.CinemaId"
                           class="form-label">
                        Cinema
                    </label>

                    <select asp-for="Movie.CinemaId"
                            asp-items="ViewBag.Cinemas"
                            class="form-select">

                        <option value="">
                            -- Select Cinema --
                        </option>

                    </select>

                    <span asp-validation-for="Movie.CinemaId"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Actors -->
                <!-- ========================= -->

                <div class="mb-4">

                    <label asp-for="ActorIds"
                           class="form-label fw-bold">
                        Actors
                    </label>

                    <select asp-for="ActorIds"
                            asp-items="ViewBag.Actors"
                            class="form-select"
                            multiple
                            size="6">
                    </select>

                    <small class="text-muted">
                        Hold Ctrl to select multiple actors.
                    </small>

                </div>


                <!-- ========================= -->
                <!-- Current Sub Images -->
                <!-- ========================= -->

                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Current Images
                    </label>

                    <div class="row">

                        @if (Model.Movie.MovieImages != null &&
                             Model.Movie.MovieImages.Any())
                        {
                            foreach (var image in Model.Movie.MovieImages)
                            {
                                <div class="col-md-3 mb-3"
                                     id="image-@image.Id">

                                    <div class="position-relative">

                                        <!-- Image -->

                                        <img src="~/uploadsFile/@image.Img"
                                             class="img-fluid rounded"
                                             style="
                                                width:100%;
                                                height:180px;
                                                object-fit:cover;
                                             " />


                                        <!-- X Button -->

                                        <button type="button"
                                                class="btn btn-danger position-absolute"
                                                onclick="deleteImage(@image.Id)"
                                                title="Delete Image"
                                                style="
                                                    top:5px;
                                                    right:5px;
                                                    width:32px;
                                                    height:32px;
                                                    padding:0;
                                                    border-radius:50%;
                                                    font-size:20px;
                                                    font-weight:bold;
                                                    line-height:28px;
                                                    z-index:10;
                                                ">

                                            ×

                                        </button>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">

                                <p class="text-muted">
                                    No additional images.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <!-- ========================= -->
                <!-- Add New Sub Images -->
                <!-- ========================= -->

                <div class="mb-4">

                    <label asp-for="SubImages"
                           class="form-label fw-bold">
                        Add New Images
                    </label>

                    <input asp-for="SubImages"
                           type="file"
                           multiple
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">
                        You can select multiple images.
                    </small>

                </div>


                <!-- ========================= -->
                <!-- Buttons -->
                <!-- ========================= -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>

                        Save Changes

                    </button>


                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================= -->
<!-- Scripts -->
<!-- ========================= -->

@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        function deleteImage(id) {

            if (!confirm("Are you sure you want to delete this image?"))
            {
                return;
            }


            // Anti Forgery Token

            var token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;


            fetch(
                '@Url.Action("DeleteImage", "Movie", new { area = "Admin" })?id=' + id,
                {
                    method: 'POST',

                    headers:
                    {
                        'RequestVerificationToken': token
                    }
                }
            )
            .then(response => response.json())

            .then(data => {

                if (data.success)
                {
                    // Remove image from page

                    var image =
                        document.getElementById(
                            "image-" + id
                        );

                    if (image)
                    {
                        image.remove();
                    }
                }
                else
                {
                    alert(data.message);
                }

            })
            .catch(error => {

                console.error(error);

                alert("Error deleting image.");

            });

        }

    </script>

}