@model IEnumerable<Cinema_Ticket.Models.Actor>

<div class="container mt-4">

    <!-- Header -->
    <div class="row mb-3 align-items-center">

        <div class="col-md-6">
            <h2 class="display-6">All Actors</h2>
        </div>

        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">

            <a asp-area="Admin"
               asp-controller="Actor"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Add Actor

            </a>

        </div>

    </div>


    <!-- Actors Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Image</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var actor in Model)
                        {
                            <tr>

                                <!-- Name -->
                                <td>
                                    @actor.Name
                                </td>

                                <!-- Description -->
                                <td>
                                    @actor.Description
                                </td>

                                <!-- Image -->
                                <td>
                                    @if (!string.IsNullOrEmpty(actor.Img))
                                    {
                                        <img src="~/uploadsFile/@actor.Img"
                                             alt="@actor.Name"
                                             width="100"
                                             height="70"
                                             style="object-fit: cover;"
                                             class="rounded" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Image
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td>

                                    <!-- Edit -->
                                    <a asp-area="Admin"
                                       asp-controller="Actor"
                                       asp-action="Edit"
                                       asp-route-id="@actor.ID"
                                       class="btn btn-sm btn-warning">

                                        Edit

                                    </a>

                                    <!-- Details -->
                                    <a asp-area="Admin"
                                       asp-controller="Actor"
                                       asp-action="Details"
                                       asp-route-id="@actor.ID"
                                       class="btn btn-sm btn-info">

                                        Details

                                    </a>

                                    <!-- Delete -->
                                    <a asp-area="Admin"
                                       asp-controller="Actor"
                                       asp-action="Delete"
                                       asp-route-id="@actor.ID"
                                       class="btn btn-sm btn-danger btn-delete">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4" class="text-center">
                                No Actors Found
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<!-- Delete Confirmation -->
<script>

    document.querySelectorAll(".btn-delete").forEach(button => {

        button.addEventListener("click", function (e) {

            e.preventDefault();

            const deleteUrl = this.getAttribute("href");

            Swal.fire({

                title: "Are you sure?",

                text: "You won't be able to recover this actor!",

                icon: "warning",

                showCancelButton: true,

                confirmButtonColor: "#d33",

                cancelButtonColor: "#6c757d",

                confirmButtonText: "Yes, delete it!",

                cancelButtonText: "Cancel"

            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href = deleteUrl;

                }

            });

        });

    });

</script>