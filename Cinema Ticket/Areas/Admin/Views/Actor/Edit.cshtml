@model Cinema_Ticket.Models.Actor

<div class="container">

    <div class="row mb-3 align-items-center my-3">

        <div class="col-md-6">
            <h2 class="display-6">Edit Actor</h2>
        </div>

    </div>


    <div class="row my-3">

        <div class="col-12">

            <form method="post" enctype="multipart/form-data">

                <!-- Id -->
                <input type="hidden" asp-for="ID" />


                <!-- Name -->
                <div class="mb-3">

                    <label asp-for="Name" class="form-label">
                        Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- Current Image -->
                <div class="mb-3">

                    <label class="form-label">
                        Current Image
                    </label>

                    @if (!string.IsNullOrEmpty(Model.Img))
                    {
                        <div>
                            <img src="~/uploadsFile/@Model.Img"
                                 width="150"
                                 height="100"
                                 class="rounded"
                                 style="object-fit: cover;" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No Image
                        </p>
                    }

                </div>


                <!-- New Image -->
                <div class="mb-3">

                    <label class="form-label">
                        New Image
                    </label>

                    <input type="file"
                           class="form-control"
                           name="ImageFile"
                           accept=".png,.jpg,.jpeg" />

                    <small class="text-muted">
                        Leave empty if you don't want to change the image.
                    </small>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              style="height: 100px"
                              placeholder="Enter description">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->
                <button type="submit"
                        class="btn btn-primary">

                    Save Changes

                </button>

                <a asp-area="Admin"
                   asp-controller="Cinema"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>


