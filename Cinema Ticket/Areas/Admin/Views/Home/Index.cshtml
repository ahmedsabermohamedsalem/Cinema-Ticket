@model Cinema_Ticket.Viewmodel.DashBordVm

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">

    <!-- ================= Header ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </h2>

            <p class="text-muted mb-0">
                Cinema Ticket Management System
            </p>
        </div>

    </div>


    <!-- ================= Statistics Cards ================= -->

    <div class="row g-4">


        <!-- Categories -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Categories
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.CountCategory
                            </h2>

                        </div>

                        <div class="fs-1 text-primary">

                            <i class="bi bi-tags-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cinemas -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Cinemas
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.CountCinema
                            </h2>

                        </div>

                        <div class="fs-1 text-success">

                            <i class="bi bi-building"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Actors -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Actors
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.CountActoor
                            </h2>

                        </div>

                        <div class="fs-1 text-warning">

                            <i class="bi bi-people-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Movies -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-2">
                                Movies
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.CountMovies
                            </h2>

                        </div>

                        <div class="fs-1 text-danger">

                            <i class="bi bi-film"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Charts ================= -->

    <div class="row g-4 mt-2">


        <!-- Bar Chart -->

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-bar-chart-fill"></i>

                        Cinema Statistics

                    </h5>

                </div>


                <div class="card-body">

                    <div style="height:400px;">

                        <canvas id="cinemaBarChart"></canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- Doughnut Chart -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-pie-chart-fill"></i>

                        Statistics Overview

                    </h5>

                </div>


                <div class="card-body">

                    <div style="height:400px;">

                        <canvas id="cinemaDoughnutChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= Quick Information ================= -->

    <div class="card shadow-sm border-0 mt-4 mb-5">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-info-circle"></i>

                Quick Information

            </h5>

        </div>


        <div class="card-body">

            <div class="row text-center">


                <div class="col-md-3">

                    <h6 class="text-muted">
                        Total Categories
                    </h6>

                    <h4 class="fw-bold">
                        @Model.CountCategory
                    </h4>

                </div>


                <div class="col-md-3">

                    <h6 class="text-muted">
                        Total Cinemas
                    </h6>

                    <h4 class="fw-bold">
                        @Model.CountCinema
                    </h4>

                </div>


                <div class="col-md-3">

                    <h6 class="text-muted">
                        Total Actors
                    </h6>

                    <h4 class="fw-bold">
                        @Model.CountActoor
                    </h4>

                </div>


                <div class="col-md-3">

                    <h6 class="text-muted">
                        Total Movies
                    </h6>

                    <h4 class="fw-bold">
                        @Model.CountMovies
                    </h4>

                </div>


            </div>

        </div>

    </div>

</div>


<!-- ================= Chart.js ================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    // ================= Bar Chart =================

    const barCanvas = document.getElementById('cinemaBarChart');

    new Chart(barCanvas, {

        type: 'bar',

        data: {

            labels: [
                'Categories',
                'Cinemas',
                'Actors',
                'Movies'
            ],

            datasets: [{

                label: 'Total',

                data: [
                    @Model.CountCategory,
                    @Model.CountCinema,
                    @Model.CountActoor,
                    @Model.CountMovies
                ],

                borderWidth: 1

            }]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            scales: {

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0

                    }

                }

            }

        }

    });


    // ================= Doughnut Chart =================

    const doughnutCanvas =
        document.getElementById('cinemaDoughnutChart');

    new Chart(doughnutCanvas, {

        type: 'doughnut',

        data: {

            labels: [

                'Categories',
                'Cinemas',
                'Actors',
                'Movies'

            ],

            datasets: [{

                data: [

                    @Model.CountCategory,
                    @Model.CountCinema,
                    @Model.CountActoor,
                    @Model.CountMovies

                ],

                borderWidth: 1

            }]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {

                    position: 'bottom'

                }

            }

        }

    });

</script>